{
  "name": "teste-tecnico-mobile-appium",
  "version": "1.0.0",
  "description": "Testes E2E mobile Android com Appium + Playwright Test e relatório Allure",
  "type": "commonjs",
  "scripts": {
    "preparar": "node scripts/preparar-ambiente.js",
    "appium": "node scripts/preparar-ambiente.js && appium --address 127.0.0.1 --port 4723 --log-level warn --log appium.log",
    "test": "playwright test",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:serve": "allure serve allure-results",
    "test:allure": "npm run test; npm run allure:generate"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "allure-commandline": "^2.46.1",
    "allure-playwright": "^3.14.0",
    "appium": "^3.8.0",
    "appium-uiautomator2-driver": "^8.7.1",
    "webdriverio": "^9.32.0"
  }
}
